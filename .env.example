# Application
NEXT_PUBLIC_APP_NAME=ShineBypass
NEXT_PUBLIC_APP_URL=https://shinebypass.vercel.app

# Daily Usage Rate Limit (resets every day at 00:00 UTC)
DAILY_RATE_LIMIT=5

# Optional Redis for Distributed Serverless Rate Limiting (e.g. Upstash)
# If omitted, ShineBypass falls back to an in-memory rate-limiter suitable for single-instance or MVP development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
